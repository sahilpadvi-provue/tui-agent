{
  "name": "tui-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent": "bun run src/cli/headless.ts",
    "replay": "bun run scripts/replay.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/",
    "tui": "bun run src/cli/tui.tsx",
    "render:demo": "bun run scripts/render-demo.tsx",
    "render:check": "bun run scripts/render-check.tsx",
    "host:check": "bun run scripts/host-smoke.tsx",
    "colour:check": "bun run scripts/colour-check.ts",
    "quiet:check": "bun run scripts/quiet-resize-check.tsx",
    "input:check": "bun run scripts/input-check.tsx",
    "md:check": "bun run scripts/markdown-check.ts",
    "app:check": "bun run scripts/app-cells-smoke.tsx",
    "marks:check": "bun run scripts/marks-check.tsx",
    "motion:check": "bun run scripts/motion-check.tsx",
    "backend:check": "bun run scripts/backend-check.tsx",
    "resume:check": "bun run scripts/resume-ui-check.tsx",
    "changed:check": "bun run scripts/changed-check.ts",
    "width:check": "bun run scripts/width-check.ts",
    "permission:check": "bun run scripts/permission-check.tsx",
    "clock:check": "bun run scripts/clock-check.tsx",
    "theme:check": "bun run scripts/theme-check.tsx",
    "sessions": "bun run src/cli/sessions.ts",
    "evals": "bun run evals/run.ts",
    "build": "bun build --compile src/cli/tui.tsx --outfile dist/tui --external react-devtools-core && bun build --compile src/cli/headless.ts --outfile dist/agent"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "ink": "^7.1.1",
    "@types/react": "^19.2.0",
    "typescript": "^5.7.0"
  }
}
